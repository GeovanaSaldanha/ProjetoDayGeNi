  "main": "server.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "db:up": "docker start ProjetoDayGeNi || docker run -d --name ProjetoDayGeNi -p 127.0.0.1:27017:27017 -v ProjetoDayGeNi-data:/data/db mongo:8",
    "db:down": "docker stop ProjetoDayGeNi",
    "db:logs": "docker logs -f ProjetoDayGeNi",
    "db:reset": "docker rm -f ProjetoDayGeNi; docker volume rm ProjetoDayGeNi-data",
    "predev": "npm run db:up",
    "dev": "node --watch src/server.js",
    "start": "node src/server.js"
  },
